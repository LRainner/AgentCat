{
  "name": "agent-cat",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:macos": "tauri build --bundles app",
    "build:windows": "tauri build --bundles nsis",
    "build:ci:macos": "tauri build --bundles app --config src-tauri/tauri.ci.conf.json",
    "build:ci:windows": "tauri build --bundles nsis --config src-tauri/tauri.ci.conf.json",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.8.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
